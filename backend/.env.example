APP_NAME="Lola Sport Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Absolute path optional; default: backend/database/database.sqlite
# DB_DATABASE=/absolute/path/database.sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=lola_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
